// extensions inspired by Factor & Kitten

// permissions: extending concept of impure functions by allowing specific sideeffects
// takes no inputs, produces no outputs, and has permission to do I/O, see Kitten
function newline():void can IO {
  echo "\n";
}

// return multiple values
{ $1+$2, $1*$2 }($very_long_first_arg, $very_long_second_arg)
|> callable_of_two_parameters
// using upack pipe
[$1+$2, $1*$2]($very_long_first_arg, $very_long_second_arg)
|... callable_of_two_parameters


// similar to
fn($a, $b) => [$a+$b, $a*$b]

// postfix if
{if $v1 else $v2} // fn($c) => $c ? $v1 : $v2
{? $v1 : $v2} // fn($c) => $c ? $v1 : $v2, $$ ? $v1 : $v2

// $1 + $2
{+} // fn($a, $b) => $a + $b;

// $1 / $2
{/} // fn($a, $b) => $a / $b;
{../} // fn($a, $b) => $a / $b;
{. . /} // fn($a, $b) => $a / $b;
{$ $ /} // fn($a, $b) => $a / $b;

// $$ / 10
{/10}  // fn($a) => $a / 10;
{./10} // fn($a) => $a / 10;
{.10/} // fn($a) => $a / 10;
{. 10 /} // fn($a) => $a / 10;

// 10 / $$
{10/}  // fn($b) => 10 / $b;
{10/.} // fn($b) => 10 / $b;
{10./} // fn($b) => 10 / $b;
{10 . /} // fn($b) => 10 / $b;

// strlen($$)
{strlen}

// forms and lenght
{"prefix-$from" "postfix-$to" $ str_replace};
str_replace("prefix-$from", "postfix-$to", $$);
fn($v) => str_replace("prefix-$from", "postfix-$to", $v);
